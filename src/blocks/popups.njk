<div id="submit-request" aria-hidden="true" class="popup popup-forms">
    <div class="popup__wrapper">
        <div class="popup__content">
            <button type="button" data-close class="popup__close">
                <svg aria-hidden="true" width="14" height="14">
                    <use xlink:href="img/sprite.svg#close"></use>
                </svg>
            </button>
            <div class="popup-forms__body">
                <div class="popup-forms__top">
                    <div class="popup-forms__title">
                        Заявка на консультацию
                    </div>
                </div>
                <form data-popup-message="#thanks" action="#" data-dev class="form">
                    <div class="form__inputs">
                        <div class="form__input">
                            <input data-required autocomplete="off" type="text" placeholder="Имя *" class="input">
                            <div class="form__placeholder">
                                Имя <span class="red">*</span>
                            </div>
                        </div>
                        <div class="form__input">
                            <input data-required autocomplete="off" type="text" placeholder="+7 (999) 999-99-99 *"
                                class="input telephone">
                            <div class="form__placeholder">
                                <span>+7</span> (999) 999-99-99 <span class="red">*</span>
                            </div>
                        </div>
                        <div class="form__input">
                            <input autocomplete="off" type="text" placeholder="E-mail" class="input">
                            <div class="form__placeholder">
                                E-mail
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn">
                        Отправить
                    </button>
                    <label class="checkbox">
                        <input data-required class="checkbox__input" type="checkbox" value="1" name="form[]">
                        <span class="checkbox__label">
                            <div class="checkbox__icon">
                                <svg aria-hidden="true" width="10" height="8">
                                    <use xlink:href="img/sprite.svg#check1"></use>
                                </svg>
                            </div>
                            <span class="checkbox__text">
                                Согласие с правилами по обработки
                                <a href="./">персональных данных</a>
                            </span>
                        </span>
                    </label>
                </form>
            </div>
        </div>
    </div>
</div>

<div id="thanks" aria-hidden="true" class="popup popup-forms">
    <div class="popup__wrapper">
        <div class="popup__content">
            <div data-close class="popup__close">
                <svg aria-hidden="true" width="16" height="16">
                    <use xlink:href="img/sprite.svg#close"></use>
                </svg>
            </div>
            <div class="popup-forms__body">
                <div class="popup-forms__top">
                    <div class="popup-forms__title">Спасибо за заявку!</div>
                    <p>
                        Свяжимся с вами в ближайшее время.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>